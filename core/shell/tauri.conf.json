{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrashRadar",
  "version": "0.1.0",
  "identifier": "app.trashradar.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrashRadar",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#0C0E12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SpiritUrban/file-reaper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMTgxQUY1NkVENzg3RDAKUldUUWg5ZHU5Um9ZYzRMbG1jS1VlTHZuZjJWMUp1d0lKZ0lESUtwUC9Xbmc5MkV0T0lLUW5NcUIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "publisher": "Vitaliy Dyachuk",
    "copyright": "© 2026 Vitaliy Dyachuk",
    "homepage": "https://spiriturban.github.io/file-reaper/",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Радар для сміття на диску",
    "longDescription": "TrashRadar знаходить потенційне сміття на дисках, групує його за категоріями і безпечно видаляє через Quarantine.",
    "windows": {
      "minimumWebview2Version": "111.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Ukrainian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
