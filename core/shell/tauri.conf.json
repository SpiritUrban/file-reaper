{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrashRadar",
  "version": "0.1.0",
  "identifier": "app.trashradar.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../../ui",
    "beforeBuildCommand": "npm run build --prefix ../../ui",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrashRadar",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#0C0E12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
