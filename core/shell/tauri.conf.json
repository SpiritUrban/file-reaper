{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrashRadar",
  "version": "0.1.0",
  "identifier": "app.trashradar.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrashRadar",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#0C0E12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "TrashRadar",
    "copyright": "© 2026 TrashRadar",
    "category": "Utility",
    "shortDescription": "Радар для сміття на диску",
    "longDescription": "TrashRadar знаходить потенційне сміття на дисках, групує його за категоріями і безпечно видаляє через Quarantine.",
    "windows": {
      "minimumWebview2Version": "111.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Ukrainian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
