{
  "$comment": "Структурні патерни dev-артефактів. T-049 node_modules; T-050 build/*; T-051 Unity. Реалізація: detectors::node_modules, build_artifacts, unity.",
  "schema_version": 1,
  "patterns": [
    {
      "id": "node_modules",
      "folder_name": "node_modules",
      "markers": ["package.json"],
      "marker_relation": "parent_directory",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "node_modules (перестворюється npm/yarn/pnpm)"
    },
    {
      "id": "rust_target",
      "folder_name": "target",
      "markers": ["Cargo.toml"],
      "marker_relation": "parent_directory",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "Rust target/ (cargo clean)"
    },
    {
      "id": "js_dist",
      "folder_name": "dist",
      "markers": ["package.json"],
      "marker_relation": "parent_directory",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "JS/TS dist/ (rebuild)"
    },
    {
      "id": "generic_build",
      "folder_name": "build",
      "markers": [
        "package.json",
        "CMakeLists.txt",
        "build.gradle",
        "build.gradle.kts",
        "pom.xml",
        "Cargo.toml"
      ],
      "marker_relation": "parent_directory",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "build/ (ecosystem marker required)"
    },
    {
      "id": "dotnet_obj",
      "folder_name": "obj",
      "markers": ["*.csproj", "*.sln", "*.fsproj"],
      "marker_relation": "parent_directory",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": ".NET obj/ (msbuild intermediate)"
    },
    {
      "id": "unity_library",
      "folder_name": "Library",
      "markers": ["ProjectSettings/ProjectVersion.txt", "ProjectSettings/*", "Assets/+ProjectSettings"],
      "marker_relation": "project_root",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "Unity Library (перестворюється при відкритті проєкту)"
    },
    {
      "id": "unity_temp",
      "folder_name": "Temp",
      "markers": ["ProjectSettings/ProjectVersion.txt"],
      "marker_relation": "project_root",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "Unity Temp (тимчасові файли редактора)"
    },
    {
      "id": "unity_obj",
      "folder_name": "Obj",
      "markers": ["ProjectSettings/ProjectVersion.txt"],
      "marker_relation": "project_root",
      "category": "dev_artifacts",
      "safety": "safe_to_bulk",
      "nested_policy": "outermost_only",
      "explanation": "Unity Obj (проміжні файли)"
    }
  ]
}
